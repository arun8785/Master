       IDENTIFICATION DIVISION.
       PROGRAM-ID COBOL011.
      ******************************************************************
      * READ EMPLOYEE FILE AND WRITE INTO ANOTHER FILE               ***
      ******************************************************************
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EMPL-FILE-INPUT ASSIGN TO EMPLI
           FILE STATUS IS WS-EMP-STATUSI.

           SELECT EMPL-FILE-OUTPUT ASSIGN TO EMPLO
           FILE STATUS IS WS-EMP-STATUSO.

           SELECT EMPL-FILE-OUTPUTR ASSIGN TO EMPLR
           FILE STATUS IS WS-EMP-STATUSR.

         DATA DIVISION.
         WORKING-STORAGE SECTION.
         01  NUM1            PIC 9(3) VALUE 100.
         01  NUM2            PIC 9(3) VALUE 250.
         01  NUM3            PIC 9(3) VALUE 350.
         01  RESULT-SUM      PIC 9(4).

         PROCEDURE DIVISION.
         MAIN-LOGIC.
             ADD NUM1 TO NUM2 GIVING RESULT-SUM.
             ADD NUM3 TO RESULT-SUM.
             DISPLAY "The sum of " NUM1 " and " NUM2 " is: " RESULT-SUM.
             DISPLAY "The number 1" NUM1.
             DISPLAY "The number 2" NUM2.
             DISPLAY "The number 3" NUM3.
             STOP RUN.